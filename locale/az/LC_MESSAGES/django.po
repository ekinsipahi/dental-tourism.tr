#, python-format
msgid "%(treatment)s Price in Turkey 2026 — Personal Quote"
msgstr "%(treatment)s qiyməti Türkiyə 2026 — şəxsi təklif"

#: apps/seo/views.py:140
#, python-format
msgid ""
"How much does %(treatment)s cost in Turkey? Very affordable in Istanbul, "

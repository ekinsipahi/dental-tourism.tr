#: apps/core/views.py:88
#, python-format
msgid ""
"We save your natural teeth first: root canals, fillings, minimal-prep "
"veneers — implants only if a tooth can't be saved. 35+ years, ★ %(rating)s "
"on Google."
msgstr ""
"Vi redder dine egne tenner først: rotfylling, fyllinger, skånsomme fasetter "
"— implantat bare når tannen ikke kan reddes. 35+ år, ★ %(rating)s på Google."

#: apps/core/views.py:111
#| msgid ""
